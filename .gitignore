# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node / build output ---
node_modules/
desktop/dist/
desktop/release/
*.tsbuildinfo
*.local

# --- Electron packaging artefacts (installer is 89 MB, over GitHub's 100 MB file limit) ---
*.asar
*.exe

# --- Runtime state and evidence ---
# The SQLite evidence database, per-mission folders and procedurally generated
# map tiles are produced at run time. They are reproducible from the seeded
# sample KML and are deliberately kept out of the source repository.
data/
logs/

# --- Offline basemap inputs and output ---
# The regional .osm.pbf (~1.6 GB), the pyrosm parquet cache and the rendered
# basemap geometry. All of it is reproducible with
# `python tools/offline_map.py extract && python tools/offline_map.py build`,
# and none of it belongs in a source repository or in a station's git clone.
map/

# --- Secrets ---
.env
.env.*
*.key
credentials.json

# --- OS noise ---
Thumbs.db
desktop.ini
.DS_Store
