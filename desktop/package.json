{
  "name": "rescueswarm-gcs",
  "private": true,
  "version": "2.0.0",
  "description": "Offline multi-drone Ground Control Station for Team ADRODS-X RescueSwarm",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "cross-env RESCUESWARM_DEV_URL=http://127.0.0.1:5173 electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "in.adrodsx.rescueswarm.gcs",
    "productName": "RescueSwarm GCS",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc"]
      },
      {
        "from": "../config",
        "to": "config"
      },
      {
        "from": "../samples",
        "to": "samples"
      },
      {
        "from": "dist",
        "to": "desktop/dist"
      }
    ],
    "win": {
      "target": ["nsis"],
      "artifactName": "RescueSwarm-GCS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
